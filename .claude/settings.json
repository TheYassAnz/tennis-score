{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(nodemon *)",
      "Bash(npm create vite@latest *)",
      "Bash(npm install *)",
      "Bash(npm install)",
      "Bash(npm run dev *)",
      "Bash(npm run build *)",
      "Bash(npm run preview *)",
      "Bash(npx tailwindcss *)",
      "Bash(mkdir -p ./client/app/login ./client/app/register ./client/app/dashboard ./client/app/match/new \"./client/app/match/[id]\" ./client/app/history ./client/app/leaderboard ./client/app/stats)",
      "Bash(docker run *)",
      "Bash(open -a Docker)",
      "Bash(docker info *)",
      "Bash(docker rm *)",
      "Bash(rm -rf ./client/.git)",
      "Bash(git init *)",
      "Bash(git -C . branch -m main)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)"
    ],
    "additionalDirectories": [
      "./client/app/match"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \".\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \".\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
